# Copy this file to .env (or .env.local) and fill in real values.
# Both .env and .env.local are gitignored — never commit either.

# ---------- App ----------
# Public base URL (used for Telegram webhook + dashboard deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Google Gemini ----------
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model IDs — override if Google changes naming
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ---------- Telegram ----------
# Create a bot via @BotFather, paste the token here
TELEGRAM_BOT_TOKEN=
# Bot username without @ — used for landing page CTA (https://t.me/<username>)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Optional: secret token Telegram includes on webhook requests
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_BOT_USERNAME=@Hackathon_RelAI_bot

# ---------- Supabase ----------
# Project URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (replaces "anon key" in new Supabase projects).
# Browser-safe, gated by Row-Level Security policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Database password — required for `supabase db push`, direct psql, and seeding scripts.
# Server-side only. Treat as a secret.
SUPABASE_DATABASE_PASSWORD=
# (Recommended) Secret key for server-side writes that bypass RLS.
# Replaces "service_role key" in new Supabase projects. Server-side only.
# Generate from Supabase Dashboard → Project Settings → API keys.
SUPABASE_SECRET_KEY=

# ---------- Dev flags ----------
# Set to "true" to use seeded fallback data instead of live Gemini calls
USE_DEMO_FALLBACK=false
