# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# ---------- App ----------
# Public base URL (used for Telegram webhook + dashboard deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Google Gemini ----------
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model IDs — override if Google changes naming
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ---------- Telegram ----------
# Create a bot via @BotFather, paste the token here
TELEGRAM_BOT_TOKEN=
# Optional: secret token Telegram includes on webhook requests
TELEGRAM_WEBHOOK_SECRET=

# ---------- Supabase ----------
# Project URL and SERVICE ROLE key (server-side only, never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Anon key for any client-side reads (optional in MVP)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Dev flags ----------
# Set to "true" to use seeded fallback data instead of live Gemini calls
USE_DEMO_FALLBACK=false
